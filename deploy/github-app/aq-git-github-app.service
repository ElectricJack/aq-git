[Unit]
Description=Refresh the aq-git token for ElectricJack/aq-graph
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/aq-git/github-app.env
LoadCredential=app-key.pem:/etc/aq-git/github-app.pem
ExecStart=/usr/bin/python3 /usr/local/libexec/aq-git-github-app-refresh.py
TimeoutStartSec=45s
StateDirectory=aq-git-github-app
StateDirectoryMode=0711
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
