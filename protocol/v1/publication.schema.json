{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publish parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "target",
    "expected_old"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "target": {
      "type": "string",
      "pattern": "^refs/heads/"
    },
    "expected_old": {
      "$ref": "request.schema.json#/$defs/object_id",
      "description": "Exact old commit; forty zeroes requires the target branch to be absent."
    },
    "update": {
      "enum": [
        "fast_forward",
        "replace"
      ],
      "description": "replace is limited to allowed_target_prefixes branches and swaps the branch under the exact expected_old lease."
    }
  }
}
