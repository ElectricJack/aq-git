{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aq-git v1 operation parameters",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "oid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha1"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "name",
        "email",
        "message"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "central",
            "worker"
          ]
        },
        "binding_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "object_format": {
          "const": "sha1"
        },
        "allowed_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_target_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^refs/heads/.+/$"
          }
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "allow_file_transport": {
          "type": "boolean"
        },
        "feature_profile": {}
      },
      "required": [
        "identity",
        "mode"
      ]
    },
    "replacement_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "central",
            "worker"
          ]
        },
        "binding_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "object_format": {
          "const": "sha1"
        },
        "allowed_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_target_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^refs/heads/.+/$"
          }
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "allow_file_transport": {
          "type": "boolean"
        },
        "feature_profile": {},
        "repository_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "repository_id",
        "identity",
        "mode",
        "binding_generation",
        "object_format"
      ]
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "service_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "repo_show": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "repo_register": {
      "oneOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "binding"
          ]
        }
      ]
    },
    "repo_binding_update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/replacement_binding"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "binding",
        "reason"
      ]
    },
    "repo_sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": []
    },
    "repo_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_age_ms": {
          "type": "integer"
        }
      },
      "required": []
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oid": {
          "$ref": "#/$defs/oid"
        }
      },
      "required": [
        "oid"
      ]
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oid": {
          "$ref": "#/$defs/oid"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "recursive": {
          "type": "boolean"
        }
      },
      "required": [
        "oid"
      ]
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/oid"
        },
        "target": {
          "$ref": "#/$defs/oid"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "base",
        "target"
      ]
    },
    "contains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ancestor": {
          "$ref": "#/$defs/oid"
        },
        "descendant": {
          "$ref": "#/$defs/oid"
        }
      },
      "required": [
        "ancestor",
        "descendant"
      ]
    },
    "query_batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "const": "inspect"
                  },
                  "params": {
                    "$ref": "#/$defs/inspect"
                  }
                },
                "required": [
                  "operation",
                  "params"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "const": "tree"
                  },
                  "params": {
                    "$ref": "#/$defs/tree"
                  }
                },
                "required": [
                  "operation",
                  "params"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "const": "diff"
                  },
                  "params": {
                    "$ref": "#/$defs/diff"
                  }
                },
                "required": [
                  "operation",
                  "params"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "const": "contains"
                  },
                  "params": {
                    "$ref": "#/$defs/contains"
                  }
                },
                "required": [
                  "operation",
                  "params"
                ]
              }
            ]
          },
          "maxItems": 100
        }
      },
      "required": [
        "items"
      ]
    },
    "workspace_create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/oid"
        }
      },
      "required": [
        "base"
      ]
    },
    "workspace_inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "workspace_id"
      ]
    },
    "workspace_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/uuid"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "expected_head": {
          "$ref": "#/$defs/oid"
        },
        "quiescent": {
          "const": true
        },
        "mode": {
          "enum": [
            "head",
            "all"
          ]
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workspace_id",
        "expected_generation",
        "expected_head",
        "quiescent"
      ]
    },
    "workspace_retire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/uuid"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "expected_head": {
          "$ref": "#/$defs/oid"
        },
        "quiescent": {
          "const": true
        }
      },
      "required": [
        "workspace_id",
        "expected_generation",
        "expected_head",
        "quiescent"
      ]
    },
    "artifact_export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/oid"
        },
        "base": {
          "$ref": "#/$defs/oid"
        },
        "retention_handle": {
          "$ref": "#/$defs/uuid"
        },
        "confirmed_prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oid"
          }
        },
        "reference_only": {
          "type": "boolean"
        },
        "caller_correlation": {}
      },
      "required": [
        "source",
        "base",
        "retention_handle"
      ]
    },
    "artifact_import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_handle": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "artifact_handle"
      ]
    },
    "candidate_create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/oid"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "oid": {
                "$ref": "#/$defs/oid"
              },
              "retention_handle": {
                "$ref": "#/$defs/uuid"
              }
            },
            "required": [
              "oid",
              "retention_handle"
            ]
          },
          "maxItems": 64
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "merge_profile": {
          "const": "git-ort-v1"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "base",
        "sources",
        "commit"
      ]
    },
    "candidate_show": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "candidate_id"
      ]
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/uuid"
        },
        "target": {
          "type": "string",
          "pattern": "^refs/heads/"
        },
        "expected_old": {
          "$ref": "#/$defs/oid",
          "description": "Exact old commit; forty zeroes requires the target branch to be absent."
        },
        "update": {
          "enum": [
            "fast_forward",
            "replace"
          ],
          "description": "replace is limited to allowed_target_prefixes branches and swaps the branch under the exact expected_old lease."
        }
      },
      "required": [
        "candidate_id",
        "target",
        "expected_old"
      ]
    },
    "operation_show": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_operation_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "target_operation_id"
      ]
    },
    "operation_reconcile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "target_operation_id",
        "expected_generation"
      ]
    },
    "operation_resolve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "disposition": {
          "enum": [
            "abandon",
            "permit_new_operation"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "old_publishers_stopped": {
          "const": true
        },
        "evidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        }
      },
      "required": [
        "target_operation_id",
        "expected_generation",
        "disposition",
        "reason",
        "old_publishers_stopped",
        "evidence"
      ]
    },
    "retention_inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handle_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "required": []
    },
    "retention_release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/uuid"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "oid": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "name",
              "oid"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "handle_id",
        "expected_generation",
        "refs",
        "reason"
      ]
    },
    "repo_cache_evict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_storage_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reconstructible": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expected_storage_generation",
        "reconstructible",
        "reason"
      ]
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "indexes",
            "repack",
            null
          ]
        }
      },
      "required": []
    },
    "recovery_clear_fence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_incarnation": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        },
        "old_environment_stopped": {
          "const": true
        }
      },
      "required": [
        "expected_incarnation",
        "reason",
        "evidence",
        "old_environment_stopped"
      ]
    }
  }
}
