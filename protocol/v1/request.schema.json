    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "repo.register",
              "repo.binding-update",
              "repo.sync",
              "repo.cache-evict",
              "workspace.create",
              "workspace.checkpoint",
              "workspace.retire",
              "artifact.export",
              "artifact.import",
              "candidate.create",
              "publish",
              "operation.reconcile",
              "operation.resolve",
              "retention.release",
              "maintenance"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "repository_id",
          "operation_id",
          "expected_binding_generation"
        ],
        "properties": {
          "repository_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "expected_binding_generation": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recovery.clear-fence"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "operation_id"
        ],
        "properties": {
          "repository_id": {
            "type": "null"
          },
          "expected_binding_generation": {
            "type": "null"
          },
