{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aq-git.local/protocol/v1/request.schema.json",
  "title": "aq-git protocol v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "operation"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
    },
    "operation": {
      "type": "string"
    },
    "repository_id": {
      "$ref": "#/$defs/optional_uuid"
    },
    "operation_id": {
      "$ref": "#/$defs/optional_uuid"
    },
    "expected_binding_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "params": {
      "type": "object"
    },
    "deadline_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  },
  "$defs": {
    "optional_uuid": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "object_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "hex"
      ],
      "properties": {
        "algorithm": {
          "const": "sha1"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  },
